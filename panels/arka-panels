#!/bin/bash
# arka-panels — put the ArkaOS top bar on any screen that doesn't have one yet.
# Started at login (arka-panels.service) and by the arka-panels KWin script
# when a screen is added. It runs arka-layout.js with arkaKeepPanels set, which
# only adds bars: it never removes a panel, and a screen gets a bar only once.

LAYOUT=/usr/share/arka/arka-layout.js
[ -f "$LAYOUT" ] || exit 0

# Wait (up to 30 s) until plasmashell is on the session bus.
for _ in $(seq 1 60); do
    dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus.NameHasOwner string:org.kde.plasmashell 2>/dev/null | grep -q "boolean true" && break
    sleep 0.5
done
# Plasma makes a new screen's desktop a moment after KWin reports the screen.
sleep 2

dbus-send --session --type=method_call --dest=org.kde.plasmashell \
    /PlasmaShell org.kde.PlasmaShell.evaluateScript \
    string:"var arkaKeepPanels = true; $(cat "$LAYOUT")" 2>/dev/null || true

# The top bar shows the spaces (virtual desktops). An account made before the bar
# had them has one, which leaves nothing to switch between, so give it three, once.
# An account that already has more than one is left alone, and so is one that
# later goes back to a single space.
MARK="$HOME/.config/arka-spaces-done"
if [ ! -f "$MARK" ]; then
    COUNT=$(dbus-send --session --print-reply --dest=org.kde.KWin /VirtualDesktopManager \
        org.freedesktop.DBus.Properties.Get string:org.kde.KWin.VirtualDesktopManager string:count 2>/dev/null |
        awk '/variant/ {print $3}')
    if [ "$COUNT" = 1 ]; then
        for n in 2 3; do
            dbus-send --session --type=method_call --dest=org.kde.KWin /VirtualDesktopManager \
                org.kde.KWin.VirtualDesktopManager.createDesktop uint32:$((n - 1)) string:"Desktop $n" 2>/dev/null || true
        done
    fi
    [ -n "$COUNT" ] && : > "$MARK"
fi
