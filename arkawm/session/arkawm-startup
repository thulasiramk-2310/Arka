#!/bin/sh
# Runs inside ArkaWM once it is up: tells the user's services where the screen is, then starts
# the user's programs.

# Services started on demand (portals, notifications) need to know about this session. Skipped
# when another desktop of the same user is already running, so that one is left alone.
# QT_QPA_PLATFORMTHEME too: KDE's portal is a Qt program, and without it the portal told apps
# "light, blue accent" (Qt's own defaults) whatever look was chosen.
vars="WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME XCURSOR_THEME XCURSOR_SIZE"
if ! systemctl --user show-environment 2>/dev/null | grep -q '^WAYLAND_DISPLAY='; then
    systemctl --user import-environment $vars 2>/dev/null
    dbus-update-activation-environment $vars 2>/dev/null
    # The portal service starts only inside a graphical session (see arkawm-session.target).
    systemctl --user start arkawm-session.target 2>/dev/null
    # stop the session's services and forget the variables again when ArkaWM ends
    trap 'systemctl --user stop arkawm-session.target 2>/dev/null; systemctl --user unset-environment $vars 2>/dev/null' EXIT
fi

# GTK apps take their icons, pointer and light or dark look from these settings. Plasma copies
# its own choices into them; ArkaWM has no settings of its own for these, so it copies the same
# KDE choices at every start. Without it GTK apps fell back to icons that lack many of the ones
# ArkaOS apps use, and showed blanks.
config=${XDG_CONFIG_HOME:-$HOME/.config}
kde_value() { sed -n "/^\[$2\]/,/^\[/s/^$3=//p" "$config/$1" 2>/dev/null | head -n 1; }
if command -v gsettings >/dev/null; then
    icons=$(kde_value kdeglobals Icons Theme)
    scheme=$(kde_value kdeglobals General ColorScheme)
    case $scheme in *Light*) look=prefer-light ;; *) look=prefer-dark ;; esac
    gsettings set org.gnome.desktop.interface icon-theme "${icons:-Arka}" 2>/dev/null
    gsettings set org.gnome.desktop.interface cursor-theme "$XCURSOR_THEME" 2>/dev/null
    gsettings set org.gnome.desktop.interface color-scheme "$look" 2>/dev/null
fi

# The password prompt for administrator actions (joining Wi-Fi, updates, system settings) is
# started by arkawm-session.target above. Only inside another desktop, where that is skipped,
# the desktop's own prompt is used.

# The user's own start-up programs if there are any. Otherwise the ArkaOS desktop (arka-desk:
# wallpaper, app ring, menu, status cards, top strip), or failing that a terminal so the screen
# is not empty. The theme is the one word in ~/.config/arkawm/theme: sky-blue or emerald.
here=$(dirname "$(readlink -f "$0")")/..
autostart=${XDG_CONFIG_HOME:-$HOME/.config}/arkawm/autostart
desk=$(command -v arka-desk || echo "$here/shell-legacy/target/debug/arka-desk")
# The ArkaOS wheel (Super+Alt+C, Super+Alt+E) runs hidden for the whole session, when installed.
wheel=$(command -v arka-wheel || true)
[ -n "$wheel" ] && "$wheel" &
# The privacy dots (which program uses the microphone, camera or screen). Their autostart entry
# is for Plasma only, so ArkaWM starts them itself when they are installed.
dots=$(command -v arka-privacy-dots || true)
[ -n "$dots" ] && GSK_RENDERER=cairo "$dots" &
# Lock after 5 minutes without input and before the computer sleeps, as on the Plasma desktop.
# A swayidle config of the user's own replaces this.
idle=$(command -v swayidle || true)
if [ -n "$idle" ]; then
    if [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/swayidle/config" ]; then
        "$idle" -w &
    else
        lock="arka-lock -f"
        command -v arka-lock >/dev/null || lock="swaylock -f"
        "$idle" -w timeout 300 "$lock" before-sleep "$lock" &
    fi
fi
if [ -x "$autostart" ]; then
    "$autostart" &
elif [ -x "$desk" ]; then
    "$desk" &
else
    ${ARKAWM_TERMINAL:-konsole} &
fi
# stay alive for the length of the session, so the EXIT trap runs at its end
wait
while kill -0 "$PPID" 2>/dev/null; do sleep 5; done
