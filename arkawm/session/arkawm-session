#!/bin/sh
# ArkaWM as a login session: chosen on the login screen, it takes the screen itself.
# Prototype. Alt+Shift+E ends the session and returns to the login screen.
here=$(dirname "$(readlink -f "$0")")/..
state=${XDG_STATE_HOME:-$HOME/.local/state}/arkawm
mkdir -p "$state"
# keep the previous session's log for one more login
[ -f "$state/session.log" ] && mv -f "$state/session.log" "$state/session.log.old"

# From the login screen there is no desktop underneath. (Set ARKAWM_BACKEND=winit to try this
# script inside another desktop.)
if [ -z "$ARKAWM_BACKEND" ]; then
    export ARKAWM_BACKEND=udev
    unset WAYLAND_DISPLAY DISPLAY
fi
# programs installed for this user only (arka-wheel, arka-convert) live here
export PATH="$HOME/.local/bin:$PATH"
export XDG_CURRENT_DESKTOP=ArkaWM XDG_SESSION_DESKTOP=arkawm XDG_SESSION_TYPE=wayland
# Qt and KDE apps look as they do on the Plasma desktop: the Arka icons, the ArkaOS colours and
# fonts, KDE's file dialogs. Without this their icons were blank in ArkaWM (reported on hardware).
export QT_QPA_PLATFORMTHEME=kde
# The pointer of the Plasma desktop, for X11 apps and anything that reads these.
cursor=$(sed -n '/^\[Mouse\]/,/^\[/s/^cursorTheme=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/kcminputrc" 2>/dev/null | head -n 1)
export XCURSOR_THEME=${cursor:-ArkaCursor} XCURSOR_SIZE=${XCURSOR_SIZE:-24}

bin=$here/target/release/arkawm
[ -x "$bin" ] || bin=$here/target/debug/arkawm
# installed in the image
[ -x "$bin" ] || bin=$(command -v arkawm)
if [ ! -x "$bin" ]; then
    echo "arkawm is not built: run 'cargo build' in $here" > "$state/session.log"
    exit 1
fi
exec "$bin" -c "exec $(dirname "$(readlink -f "$0")")/arkawm-startup" > "$state/session.log" 2>&1
