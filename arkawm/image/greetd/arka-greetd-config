#!/bin/sh
# Writes greetd's settings for this boot to /run/arka-greetd/config.toml, before greetd starts.
# The sign-in screen is arka-lock --greeter inside cage. When first-boot setup turned on
# automatic sign-in (it writes that for SDDM, the Plasma image's login screen), that account's
# session starts straight away instead; signing out then shows the sign-in screen.
set -eu
out=/run/arka-greetd
mkdir -p "$out"
# cairo: GTK's GL renderer draws black under cage on machines without working 3D (VMs).
greeter='env GSK_RENDERER=cairo cage -s -d -- /usr/bin/arka-lock --greeter'
{
    printf '[terminal]\nvt = 1\n\n'
    printf '[default_session]\ncommand = "%s"\nuser = "greetd"\n' "$greeter"
} > "$out/config.toml.new"

auto=/etc/sddm.conf.d/20-autologin.conf
if [ -r "$auto" ]; then
    user=$(sed -n 's/^User=//p' "$auto" | tail -n 1)
    session=$(sed -n 's/^Session=//p' "$auto" | tail -n 1)
    session=${session##*/}
    file=/usr/share/wayland-sessions/$session
    command=
    [ -n "$session" ] && [ -r "$file" ] &&
        command=$(sed -n '/^\[Desktop Entry\]/,/^\[/s/^Exec=//p' "$file" | head -n 1 | sed 's/ %[a-zA-Z]//g')
    # only a real account and a command that needs no quoting in TOML
    if [ -n "$user" ] && [ -n "$command" ] && getent passwd "$user" >/dev/null &&
        ! printf '%s%s' "$user" "$command" | grep -q '["\\]'; then
        printf '\n[initial_session]\ncommand = "%s"\nuser = "%s"\n' "$command" "$user" >> "$out/config.toml.new"
    else
        echo "arka-greetd-config: automatic sign-in in $auto is not usable; showing the sign-in screen" >&2
    fi
fi
mv "$out/config.toml.new" "$out/config.toml"
