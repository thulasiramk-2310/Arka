#!/bin/bash
# arka-apply-look — switch the current user's desktop to the ArkaOS Light or
# Dark look. Used by the first-login script (the look chosen in setup) and by
# ArkaOS Settings > Appearance. Runs as the user inside their Plasma session;
# changes only that user's settings, and every one stays changeable in
# System Settings.
#
#   arka-apply-look light|dark
#
# Applies colours, Plasma style and icons only, not a whole global theme, so
# Arka icons/cursor/sounds stay. A wallpaper the user picked themselves (Settings
# records it in ~/.config/arkaos/wallpaper) is kept; otherwise the matching
# ArkaOS wallpaper is used. The login screen is system-wide and needs an
# administrator, so it is not changed here.
set -u

LOOK=${1:-}
case "$LOOK" in light|dark) ;; *) echo "usage: arka-apply-look light|dark" >&2; exit 2 ;; esac

# Remember the current Plasma style and icons: the panel only needs restarting
# when one of these actually changes (a pre-seeded first login changes neither).
before="$(kreadconfig6 --file plasmarc --group Theme --key name 2>/dev/null)|$(kreadconfig6 --file kdeglobals --group Icons --key Theme 2>/dev/null)"

mkdir -p "$HOME/.config"
printf '%s\n' "$LOOK" > "$HOME/.config/arka-look"

# Fedora ships the icon switcher in libexec; other distros in lib.
CHANGEICONS=$(ls /usr/libexec/plasma-changeicons /usr/lib/plasma-changeicons 2>/dev/null | head -1)
set_icons() {
    { [ -n "$CHANGEICONS" ] && "$CHANGEICONS" "$1" >/dev/null 2>&1; } ||
        kwriteconfig6 --file kdeglobals --group Icons --key Theme "$1"
}

WALL=/usr/share/arka/wallpapers/default-$LOOK.png
CUSTOM=$(cat "$HOME/.config/arkaos/wallpaper" 2>/dev/null || true)
case "$CUSTOM" in ""|/usr/share/arka/wallpapers/default*) DESK_WALL=$WALL ;; *) DESK_WALL=$CUSTOM ;; esac

if [ "$LOOK" = light ]; then
    plasma-apply-colorscheme ArkaOSLight >/dev/null 2>&1 || true
    plasma-apply-desktoptheme arkaos-light >/dev/null 2>&1 || true
    set_icons Arka-Light
    kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage org.arkaos.light.desktop
else
    plasma-apply-colorscheme ArkaOS >/dev/null 2>&1 || true
    plasma-apply-desktoptheme arkaos-dark >/dev/null 2>&1 || true
    set_icons Arka
    kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage org.arkaos.dark.desktop
fi

# The dock (Crystal Dock) has its own colour settings: match the look, and
# restart it if it is running so it picks them up.
if [ "$LOOK" = light ]; then
    dock_bg='#99f6f7f9' dock_border='#33000000' dock_dot='#3c4148'
else
    dock_bg='#a61c2027' dock_border='#33ffffff' dock_dot='#e6e8eb'
fi
for DOCKCONF in "$HOME"/.config/crystal-dock/KDE/appearance.conf "$HOME"/.config/crystal-dock/generic/appearance.conf; do
    [ -f "$DOCKCONF" ] || continue
    kwriteconfig6 --file "$DOCKCONF" --group General --key backgroundColor2D "$dock_bg"
    kwriteconfig6 --file "$DOCKCONF" --group General --key borderColor "$dock_border"
    kwriteconfig6 --file "$DOCKCONF" --group General --key activeIndicatorColor2D "$dock_dot"
    kwriteconfig6 --file "$DOCKCONF" --group General --key inactiveIndicatorColor2D "$dock_dot"
    kwriteconfig6 --file "$DOCKCONF" --group General --key borderColor2D --delete
done
if [ -d "$HOME/.config/crystal-dock" ]; then
    if pkill -u "$(id -u)" -x crystal-dock; then
        sleep 0.5
        setsid crystal-dock >/dev/null 2>&1 < /dev/null &
    fi
fi

# The ArkaOS accent stays green in both looks (changeable in System Settings).
kwriteconfig6 --file kdeglobals --group General --key AccentColor "22,199,132"
kwriteconfig6 --file kdeglobals --group General --key accentColorFromWallpaper false

# The lock screen keeps the dark wallpaper in both looks, as the login screen
# does: its clock and text are white, and on the light wallpaper they were
# hard to read.
kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image \
    --group General --key Image "file:///usr/share/arka/wallpapers/default.png"

# The panel keeps the old Plasma style's icon colours until it restarts (seen
# in the VM: tray icons stayed light-on-light). Restart it once (about 2 s),
# and only if the style or icons really changed. Restart BEFORE setting the
# wallpaper: stopping Plasma while it is still scaling a new wallpaper crashed
# it (SIGSEGV in the wallpaper loader thread, VM 2026-10-18).
after="$(kreadconfig6 --file plasmarc --group Theme --key name 2>/dev/null)|$(kreadconfig6 --file kdeglobals --group Icons --key Theme 2>/dev/null)"
if [ "$before" != "$after" ]; then
    # Plasma's unit allows 3 starts a minute; a 4th look switch within a
    # minute left the desktop without Plasma (VM 2026-10-18). Clear the count.
    systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
    systemctl --user restart plasma-plasmashell.service >/dev/null 2>&1 || true
    # Wait (up to 20 s) until the new Plasma is on the session bus again.
    for _ in $(seq 1 40); do
        dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus \
            org.freedesktop.DBus.NameHasOwner string:org.kde.plasmashell 2>/dev/null | grep -q "boolean true" && break
        sleep 0.5
    done
fi
[ -f "$DESK_WALL" ] && plasma-apply-wallpaperimage "$DESK_WALL" >/dev/null 2>&1
exit 0
