[Desktop Entry]
Type=Service
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;image/avif;application/pdf;audio/mpeg;audio/x-wav;audio/wav;audio/flac;audio/x-flac;audio/ogg;audio/opus;audio/mp4;audio/x-m4a;audio/aac;video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/ogg;text/plain;
Actions=wheel;wheel_edit;
X-KDE-Priority=TopLevel

[Desktop Action wheel]
Name=Convert with the format wheel
Exec=arka-wheel --files %F
Icon=document-export

[Desktop Action wheel_edit]
Name=Edit with the edit wheel
Exec=arka-wheel --edit --files %F
Icon=document-edit
