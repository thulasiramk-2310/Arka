ANNOTATE_KINDS = {"pen", "arrow", "box", "highlight", "text"}


def shapes_text(arg):
    """The JSON itself, or read from the file "@PATH" names. The edit window hands a drawing over as a
    file in the user's private runtime folder and it is removed once read; the worker's copy lives in
    the scratch folder."""
    if not arg.startswith("@"):
        return arg
    path = Path(arg[1:])
    try:
        if path.stat().st_size > 8 * 1024 * 1024:
            raise RuntimeError("the drawing is too big")
        text = path.read_text()
    except OSError:
        raise RuntimeError("the drawing could not be read") from None
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime and path.parent == Path(runtime):
        path.unlink(missing_ok=True)
    return text


def annotate_shapes(text):
    """Check the shapes for "annotate". JSON: a list of
         {"t": "pen"|"arrow"|"box"|"highlight"|"text", "c": "#RRGGBB", "w": width,
          "p": [x, y, ...], "s": "words" (text only)}
    in picture pixels. pen: any number of points; arrow: from and to; box and highlight: x y w h;
    text: where its top left goes, w is the letter height."""
    import json
    import re
    try:
        shapes = json.loads(text)
    except ValueError:
        raise RuntimeError("the drawing could not be read") from None
    if not isinstance(shapes, list) or not shapes or len(shapes) > 500:
        raise RuntimeError("there is nothing to draw, or too much")
    points = 0
    for sh in shapes:
        if not isinstance(sh, dict) or sh.get("t") not in ANNOTATE_KINDS:
            raise RuntimeError("the drawing has an unknown shape")
        if not re.fullmatch(r"#[0-9a-fA-F]{6}", str(sh.get("c", ""))):
            raise RuntimeError("a colour is written like #E5484D")
        w, p = sh.get("w"), sh.get("p")
        if not isinstance(w, (int, float)) or not 1 <= w <= 400:
            raise RuntimeError("a line or letter size is 1 to 400")
        if not isinstance(p, list) or not all(isinstance(v, (int, float)) and -1e5 < v < 1e5 for v in p):
            raise RuntimeError("a shape has bad points")
        need = {"pen": None, "arrow": 4, "box": 4, "highlight": 4, "text": 2}[sh["t"]]
        if (need and len(p) != need) or (not need and (len(p) < 2 or len(p) % 2)):
            raise RuntimeError(f"a {sh['t']} has the wrong number of points")
        if sh["t"] == "text" and (not isinstance(sh.get("s"), str) or not 0 < len(sh["s"]) <= 300):
            raise RuntimeError("a text needs 1 to 300 letters")
        points += len(p)
    if points > 100000:
        raise RuntimeError("the drawing has too many points")
    return shapes


_FONT_FILE = []


def annotate_font(size):
    """A real font for the letters, found once the way the desktop finds one; Pillow's own if none."""
    from PIL import ImageFont
    if not _FONT_FILE:
        try:
            _FONT_FILE.append(subprocess.run(["fc-match", "-f", "%{file}", "sans-serif:weight=bold"],
                                             capture_output=True, text=True, timeout=10).stdout.strip())
        except (OSError, subprocess.SubprocessError):
            _FONT_FILE.append("")
    try:
        if _FONT_FILE[0]:
            return ImageFont.truetype(_FONT_FILE[0], size)
    except OSError:
        pass
    return ImageFont.load_default(size)


def draw_shapes(im, shapes):
    """Draw annotate shapes on an RGBA picture. Highlights are see-through; the rest is solid."""
    import math
    from PIL import Image, ImageDraw
    over = Image.new("RGBA", im.size, (0, 0, 0, 0))
    marks = ImageDraw.Draw(over)
    draw = ImageDraw.Draw(im)
    pending = False
    for sh in shapes:
        rgb = tuple(int(sh["c"][i:i + 2], 16) for i in (1, 3, 5))
        w, p = max(1, round(sh["w"])), sh["p"]
        if sh["t"] == "highlight":
            x, y, bw, bh = p
            marks.rectangle((x, y, x + bw, y + bh), fill=rgb + (96,))
            pending = True
            continue
        # Earlier highlights go under later lines and letters.
        if pending:
            im.alpha_composite(over)
            over = Image.new("RGBA", im.size, (0, 0, 0, 0))
            marks = ImageDraw.Draw(over)
            pending = False
        if sh["t"] == "pen":
            pts = list(zip(p[0::2], p[1::2]))
            if len(pts) == 1:
                pts = pts * 2
            draw.line(pts, fill=rgb + (255,), width=w, joint="curve")
            r = w / 2  # round ends
            for x, y in (pts[0], pts[-1]):
                draw.ellipse((x - r, y - r, x + r, y + r), fill=rgb + (255,))
        elif sh["t"] == "box":
            x, y, bw, bh = p
            draw.rectangle((x, y, x + bw, y + bh), outline=rgb + (255,), width=w)
        elif sh["t"] == "arrow":
            x0, y0, x1, y1 = p
            ang = math.atan2(y1 - y0, x1 - x0)
            head = w * 3 + 8
            back = (x1 - head * 0.8 * math.cos(ang), y1 - head * 0.8 * math.sin(ang))
            draw.line((x0, y0, *back), fill=rgb + (255,), width=w)
            left = (x1 - head * math.cos(ang - 0.45), y1 - head * math.sin(ang - 0.45))
            right = (x1 - head * math.cos(ang + 0.45), y1 - head * math.sin(ang + 0.45))
            draw.polygon([(x1, y1), left, right], fill=rgb + (255,))
        else:
            font = annotate_font(w)
            x, y = p
            outline = (0, 0, 0, 255) if sum(rgb) > 382 else (255, 255, 255, 255)
            draw.text((x, y), sh["s"], font=font, fill=rgb + (255,), stroke_width=max(1, w // 14),
                      stroke_fill=outline)
    if pending:
        im.alpha_composite(over)
    return im


def edit_image_worker(op, src, dst, args):
    """Runs inside the sandbox: one picture edit with Pillow."""
    from PIL import Image, ImageDraw, ImageOps
    with Image.open(src) as im:
        im.seek(0)
        im = ImageOps.exif_transpose(im)  # edit what is seen, not the raw pixels
        if op == "rotate":
            im = im.rotate({"left": 90, "right": -90, "flip": 180}[args[0]], expand=True)
        elif op == "crop":
            x, y, w, h = map(int, args)
            if w < 1 or h < 1 or x < 0 or y < 0 or x + w > im.width or y + h > im.height:
                raise RuntimeError(f"that box is outside the picture ({im.width} x {im.height})")
            im = im.crop((x, y, x + w, y + h))
        elif op == "redact":
            boxes = [tuple(map(int, args[i:i + 4])) for i in range(0, len(args), 4)]
            if im.mode in ("P", "LA", "PA"):
                im = im.convert("RGBA")
            elif im.mode not in ("RGB", "RGBA", "L"):
                im = im.convert("RGB")  # CMYK, 16-bit and the rest: "0" would not be black in all of them
            else:
                im = im.copy()
            draw = ImageDraw.Draw(im)
            black = (0, 0, 0, 255) if im.mode == "RGBA" else (0, 0, 0) if im.mode == "RGB" else 0
            for x, y, w, h in boxes:
                if w < 1 or h < 1:
                    raise RuntimeError("a box has no size")
                draw.rectangle((x, y, x + w - 1, y + h - 1), fill=black)  # the pixels are replaced, not covered
        elif op == "annotate":
            im = draw_shapes(im.convert("RGBA"), annotate_shapes(shapes_text(args[0])))
        elif op == "background":
            pad = int(args[1])
            fg = im.convert("RGBA")
            size = (fg.width + 2 * pad, fg.height + 2 * pad)
            colors = [] if args[0] == "none" else [tuple(int(c[i:i + 2], 16) for i in (1, 3, 5)) for c in args[0].split("-")]
            if not colors:                     # see-through room around the picture
                bg = Image.new("RGBA", size, (0, 0, 0, 0))
            elif len(colors) == 1:
                bg = Image.new("RGBA", size, colors[0] + (255,))
            else:  # top to bottom
                bg = Image.new("RGBA", size)
                top, bottom = colors[0], colors[1]
                draw = ImageDraw.Draw(bg)
                for yy in range(size[1]):
                    t = yy / max(1, size[1] - 1)
                    draw.line((0, yy, size[0], yy), fill=tuple(round(a + (b - a) * t) for a, b in zip(top, bottom)) + (255,))
            bg.alpha_composite(fg, (pad, pad))
            im = bg
        fmt = {"jpg": "JPEG", "jpeg": "JPEG", "png": "PNG", "webp": "WEBP"}.get(Path(dst).suffix.lower().lstrip("."), "PNG")
        if fmt == "JPEG" and im.mode != "RGB":
            im = im.convert("RGB")
        im.save(dst, fmt, **({"quality": 92} if fmt in ("JPEG", "WEBP") else {}))


def edit_image(op, path, args):
    """rotate, crop, redact or background on one picture; the copy is saved beside it."""
    src = Path(path).resolve()
    ext = src.suffix.lower().lstrip(".")
    if kind_of(src) != "image":
        raise RuntimeError("this only works on pictures")
    if op == "rotate" and args != [a for a in args if a in ("left", "right", "flip")][:1]:
        raise RuntimeError("rotate needs left, right or flip")
    if op in ("crop", "redact"):
        if not args or (op == "crop" and len(args) != 4) or len(args) % 4:
            raise RuntimeError("a box is four whole numbers: X Y W H")
        try:
            vals = [int(a) for a in args]
        except ValueError:
            raise RuntimeError("a box is four whole numbers: X Y W H") from None
        if any(v < 0 for v in vals) or any(vals[i] < 1 for i in range(2, len(vals), 4)) or any(vals[i] < 1 for i in range(3, len(vals), 4)):
            raise RuntimeError("a box needs a size and can't start before the picture")
    if op == "annotate":
        if len(args) != 1:
            raise RuntimeError("annotate takes the shapes as one JSON argument, or @FILE")
        args = [shapes_text(args[0])]
        annotate_shapes(args[0])  # checked here too, so a mistake is reported before anything runs
    if op == "background":
        import re
        if len(args) != 2 or not re.fullmatch(r"none|#[0-9a-fA-F]{6}(-#[0-9a-fA-F]{6})?", args[0]) \
                or not args[1].isdigit() or int(args[1]) > 2000:
            raise RuntimeError("background needs a colour like #1E90FF (or two joined with -, or none for see-through) and a padding of 0 to 2000")
    out_ext = ext if ext in ("png", "jpg", "jpeg", "webp") else "png"
    if op == "background" and args[0] == "none":
        out_ext = "png" if ext not in ("webp",) else ext   # JPEG can't keep see-through parts
    elif op in ("background", "annotate") and ext in ("jpg", "jpeg", "webp"):
        out_ext = ext
    out_dir = src.parent
    out_dir = save_dir(out_dir)
    scratch = Path(tempfile.mkdtemp(prefix=".arka-convert-", dir=out_dir))
    try:
        tmp = scratch / f"out.{out_ext}"
        if op == "annotate":
            # A long drawing is too big for one command-line argument (128 KiB on Linux), so the
            # worker reads it from the scratch folder, which the sandbox can see.
            (scratch / "shapes.json").write_text(args[0])
            args = ["@" + str(scratch / "shapes.json")]
        run(scratch, [sys.executable, "-I", os.path.realpath(__file__), "--edit-worker", op,
                      readable_image(scratch, src), str(tmp), *args], timeout=300)
        label = {"rotate": "rotated", "crop": "cropped", "redact": "redacted", "background": "with background",
                 "annotate": "annotated"}[op]
        return edit_done(scratch, [tmp], [(out_dir, f"{src.stem} ({label})", out_ext)])
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def done_title(fmt):
    """What the finished pop-up says. The wheel asks for smaller-image, smaller-video and so on; the menu asks for smaller."""
    if fmt == "smaller" or fmt.startswith("smaller-"):
        return "Made smaller"
    return {"clean": "Removed hidden details", "zip": "Zipped"}.get(fmt, "Converted")


def notify(text, body="", replace=None, urgency="normal"):
    """Show a desktop notification. Returns its id, or None."""
    if os.environ.get("ARKA_CONVERT_QUIET") == "1":
        return None
    exe = shutil.which("notify-send")
    if not exe:
        print(f"{text} {body}".strip(), file=sys.stderr)
        return None
    cmd = [exe, "-a", "ArkaOS", "-i", "document-export", "-u", urgency, "-p"]
    if replace:
        cmd += ["-r", str(replace)]
    done = subprocess.run(cmd + [text, body], capture_output=True, text=True)
    return done.stdout.strip() or None


def notify_done(text, path, replace=None):
    """The finished notification, with a "Show in Folder" button. notify-send
    has to stay alive to hear the click, so it runs in a detached copy of this
    program that ends when the notification goes away."""
    if os.environ.get("ARKA_CONVERT_QUIET") == "1" or not shutil.which("notify-send"):
        return notify(text, f"Saved as {Path(path).name}", replace)
    cmd = [sys.executable, "-I", os.path.realpath(__file__), "--notify-wait", str(path), text]
    if replace:
        cmd.append(str(replace))
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def notify_wait(path, text, replace=None):
    """--notify-wait: show the notification and open the folder if asked."""
    # -t: how long it stays up. The timeout is a backstop so this process can
    # never outlive a notification the desktop forgot to close.
    cmd = ["notify-send", "-a", "ArkaOS", "-i", "document-export", "-u", "normal", "-t", "10000", "-w",
           "-A", "show=Show in Folder"]
    if replace:
        cmd += ["-r", replace]
    try:
        done = subprocess.run(cmd + [text, f"Saved as {Path(path).name}"], capture_output=True, text=True,
                              timeout=60)
    except subprocess.TimeoutExpired:
        return
    if done.stdout.strip() == "show":
        show_in_folder(path)


def show_in_folder(path):
    """Ask the file manager (Dolphin) to open the folder with the file selected."""
    if shutil.which("dbus-send"):
        subprocess.run(["dbus-send", "--session", "--type=method_call",
                        "--dest=org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                        "org.freedesktop.FileManager1.ShowItems",
                        f"array:string:{Path(path).resolve().as_uri()}", "string:arka-convert"],
                       stdin=subprocess.DEVNULL, capture_output=True)


def refresh_folder(paths):
    """Tell open file managers that these files are new, so Dolphin lists them
    and makes their thumbnails now instead of waiting for its own watcher."""
    if not paths or os.environ.get("ARKA_CONVERT_QUIET") == "1" or not shutil.which("dbus-send"):
        return
    uris = [Path(p).resolve().as_uri() for p in paths]
    for member, arg in (("FilesAdded", f"string:{Path(paths[0]).resolve().parent.as_uri()}"),
                        ("FilesChanged", "array:string:" + ",".join(uris))):
        subprocess.run(["dbus-send", "--session", "--type=signal", "/", f"org.kde.KDirNotify.{member}", arg],
                       stdin=subprocess.DEVNULL, capture_output=True)


def run_edit(tool, args):
    """merge-pdf, split-pdf and trim: run one, tell the user, refresh Dolphin."""
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, _frame: sys.exit(128 + signum))
    wanted = {"merge-pdf": (2, None), "split-pdf": (1, 1), "trim": (3, 3), "rotate": (2, 2), "crop": (5, 5),
              "redact": (5, None), "background": (3, 3), "zip-all": (2, None), "annotate": (2, 2),
              "split-media": (2, 2), "join-media": (2, None), "bleep": (3, None)}[tool]
    if len(args) < wanted[0] or (wanted[1] and len(args) > wanted[1]):
        print(__doc__.strip().split("\n\n")[0], file=sys.stderr)
        return 2
    title = {"merge-pdf": "Merged", "split-pdf": "Split", "trim": "Trimmed", "rotate": "Rotated", "crop": "Cropped",
             "redact": "Hidden parts blacked out", "background": "Background added",
             "zip-all": "Zipped together", "annotate": "Annotated", "split-media": "Split in two",
             "join-media": "Joined", "bleep": "Bleeped"}[tool]
    media = tool in ("trim", "split-media", "join-media", "bleep") or (
        tool in ("crop", "redact") and kind_of(args[0]) == "video")
    working = {"trim": "Trimming", "split-media": "Splitting", "join-media": "Joining", "bleep": "Bleeping",
               "crop": "Cropping", "redact": "Blacking out"}
    nid = notify(working[tool], Path(args[0]).name if tool != "join-media" else f"{len([a for a in args if a != '--name-order'])} files",
                 urgency="low") if media else None
    last = [0.0]

    def progress(fraction):
        now = time.monotonic()
        if nid and now - last[0] >= 2:
            last[0] = now
            notify(working[tool], f"{int(fraction * 100)}% done", nid, "low")

    try:
        if tool == "merge-pdf":
            made = merge_pdfs(args)
        elif tool == "zip-all":
            made = zip_all(args)
        elif tool == "split-pdf":
            made = split_pdf(args[0])
        elif tool == "trim":
            made = trim_media(args[0], args[1], args[2], progress)
        elif tool == "split-media":
            made = split_media(args[0], args[1], progress)
        elif tool == "join-media":
            made = join_media(name_order(args[1:]) if args[0] == "--name-order" else args, progress)
        elif tool == "bleep":
            made = bleep_media(args[0], args[1:], progress)
        elif tool in ("crop", "redact") and kind_of(args[0]) == "video":
            made = edit_video(tool, args[0], args[1:], progress)
        else:
            made = edit_image(tool, args[0], args[1:])
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as e:
        # A ZIP of many items has no single file to name; its messages already say which one.
        notify(f"Couldn't {tool.split('-')[0]}", str(e) if tool in ("zip-all", "join-media") else f"{Path(args[0]).name}: {e}",
               nid)
        return 1
    except (SystemExit, KeyboardInterrupt):
        notify(f"{title} stopped", "Files that were not finished were not saved.", nid)
        raise
    refresh_folder(made)
    if len(made) == 1:
        notify_done(title, made[0], nid)
    else:
        notify(title, f"{len(made)} files saved" + (" in Downloads" if SAVED_ELSEWHERE else " next to the original"), nid)
    return 0


def main(argv):
    if len(argv) >= 6 and argv[1] == "--edit-worker":
        try:
            edit_image_worker(argv[2], argv[3], argv[4], argv[5:])
        except RuntimeError as e:   # one plain sentence for the notification, not a traceback
            print(e, file=sys.stderr)
            return 1
        return 0
    if len(argv) >= 5 and argv[1] == "--image-worker":
        image_worker(argv[2], argv[3], argv[4])
        return 0
    if len(argv) == 6 and argv[1] == "--image-fit-worker":
        try:
            image_fit_worker(argv[2], argv[3], argv[4], argv[5])
        except RuntimeError as e:
            print(e, file=sys.stderr)
            return 1
        return 0
    if len(argv) >= 5 and argv[1] == "--image-smaller-worker":
        image_smaller_worker(argv[2], argv[3], argv[4], argv[5] if len(argv) > 5 else "light")
        return 0
    if len(argv) >= 4 and argv[1] == "--notify-wait":
        notify_wait(argv[2], argv[3], argv[4] if len(argv) > 4 else None)
        return 0
    if len(argv) == 3 and argv[1] == "--duration":
        with tempfile.TemporaryDirectory(prefix="arka-convert-") as d:
            seconds = media_seconds(Path(d), str(Path(argv[2]).resolve()))
        print(f"{seconds:.3f}" if seconds else "")
        return 0 if seconds else 1
    if len(argv) == 3 and argv[1] == "--targets":
        print("\n".join(targets_for(argv[2])))
        return 0
    if len(argv) == 3 and argv[1] == "--find-private":
        import json
        try:
            print(json.dumps(find_private(argv[2])))
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            print(f"arka-convert: {e}", file=sys.stderr)
            return 1
        return 0
    if len(argv) == 3 and argv[1] == "--details-worker":
        details_worker(argv[2])
        return 0
    if len(argv) == 3 and argv[1] == "--details":
        import json
        try:
            print(json.dumps(file_details(argv[2])))
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            print(f"arka-convert: {e}", file=sys.stderr)
            return 1
        return 0
    if len(argv) in (4, 5) and argv[1] == "--waveform":
        try:
            save_waveform(argv[2], argv[3], argv[4] if len(argv) == 5 else "1")
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            print(f"arka-convert: {e}", file=sys.stderr)
            return 1
        return 0
    if len(argv) == 5 and argv[1] == "--frame":
        try:
            save_frame(argv[2], argv[3], argv[4])
        except (RuntimeError, OSError) as e:
            print(f"arka-convert: {e}", file=sys.stderr)
            return 1
        return 0
    if len(argv) >= 2 and argv[1] in ("merge-pdf", "split-pdf", "trim", "rotate", "crop", "redact", "background",
                                      "zip-all", "annotate", "split-media", "join-media", "bleep"):
        return run_edit(argv[1], argv[2:])
    if len(argv) < 3 or argv[1].startswith("-"):
        print(__doc__.strip().split("\n\n")[0], file=sys.stderr)
        return 2
    # Being stopped (logging out, a kill) unwinds like Ctrl+C, so the hidden
    # scratch folder is removed and no half-made file is left.
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, _frame: sys.exit(128 + signum))
    fmt, files = argv[1].lower(), argv[2:]
    fmt = "jpg" if fmt == "jpeg" else fmt
    level = "light"
    if fmt.startswith("smaller:"):
        fmt, level = "smaller", fmt.split(":", 1)[1]
        if level not in SMALLER_LEVELS:
            print(f"arka-convert: the level is one of {', '.join(SMALLER_LEVELS)}, not '{level}'", file=sys.stderr)
            return 2
    # "smaller" means the smaller-... action that fits each file, so one menu entry covers a mixed selection.
    per_file = {"image": "smaller-image", "pdf": "smaller-pdf", "audio": "smaller-audio", "video": "smaller-video"}
    heavy = any(kind_of(f) in ("audio", "video", "office") for f in files) or fmt == "docx"
    nid = notify("Making smaller" if fmt == "smaller" else f"Converting to {NAMES.get(fmt, fmt)}",
                 files[0] if len(files) == 1 else f"{len(files)} files", urgency="low") if heavy else None
    made, failed = [], []
    last = [0.0]

    def progress_for(index, name):
        # Update the notification at most every two seconds.
        def update(fraction):
            now = time.monotonic()
            if nid and now - last[0] >= 2:
                last[0] = now
                where = f" ({index + 1} of {len(files)})" if len(files) > 1 else ""
                notify(f"Converting to {NAMES.get(fmt, fmt)}", f"{name}{where}: {int(fraction * 100)}%", nid, "low")
        return update

    try:
        for i, f in enumerate(files):
            try:
                one = per_file.get(kind_of(f), "") if fmt == "smaller" else fmt
                if not one:
                    raise RuntimeError("this kind of file can't be made smaller yet")
                if fmt == "smaller" and level in FIT_LEVELS:
                    made += fit_to_size(f, level, progress_for(i, Path(f).name))
                else:
                    made += convert_one(f, one, progress_for(i, Path(f).name), level)
            except Exception as e:  # one bad file does not stop the rest
                failed.append(f"{Path(f).name}: {e}")
    except (SystemExit, KeyboardInterrupt):
        notify("Conversion stopped", "Files that were not finished were not saved.", nid)
        raise
    refresh_folder(made)
    if failed:
        notify("Couldn't convert everything", "\n".join(failed[:4]), nid)
    elif len(made) == 1:
        notify_done(done_title(fmt), made[0], nid)
    else:
        notify(done_title(fmt), f"{len(made)} files saved" + (" in Downloads" if SAVED_ELSEWHERE else " next to the originals"), nid)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
