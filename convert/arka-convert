#!/usr/bin/env python3
"""arka-convert: convert files next to the originals, with no network access.

    arka-convert FORMAT FILE...        convert each FILE to FORMAT
    arka-convert --targets FILE        list the formats FILE can become
    arka-convert clean FILE...         save a copy without hidden details
    arka-convert merge-pdf FILE FILE...  join PDFs into one, in the order given
    arka-convert split-pdf FILE        save each page of a PDF as its own PDF
    arka-convert trim FILE START END   keep only START to END of a sound or video
                                       (seconds, mm:ss or hh:mm:ss)
    arka-convert rotate FILE left|right|flip
    arka-convert crop FILE X Y W H     keep a box of a picture (pixels)
    arka-convert redact FILE X Y W H [X Y W H ...]   black out boxes of a picture
    arka-convert background FILE COLOR[-COLOR2] PADDING   put a picture on a colour

The converted file is saved beside the original (in Downloads when that folder is
read-only) and never replaces anything:
a name that is taken gets " (1)", " (2)" and so on. Every converter (ffmpeg,
pdftoppm, Ghostscript, Pillow) runs inside a bubblewrap sandbox with no network. The sandbox
can read your files but can only write into a scratch folder; the finished file
is moved out of it afterwards. If bubblewrap is missing nothing is converted.
Used by the "Convert to" entry in the Dolphin right-click menu.
"""

import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time

IMAGE = {"png", "jpg", "jpeg", "webp", "gif", "bmp", "tif", "tiff"}
AUDIO = {"mp3", "wav", "flac", "ogg", "oga", "opus", "m4a", "aac"}
VIDEO = {"mp4", "mkv", "webm", "mov", "avi", "m4v", "ogv"}

TARGETS = {
    "image": ["png", "jpg", "webp", "pdf", "clean"],
    "pdf": ["png", "smaller-pdf", "clean"],
    "audio": ["mp3", "flac", "wav", "ogg", "opus", "m4a", "clean"],
    "video": ["mp4", "mkv", "webm", "mp3", "clean"],
}

# "clean" (mat2) removes hidden details such as location, camera, author and
# editing software. Only the formats mat2 handles are offered.
CLEAN_EXT = {"png", "jpg", "jpeg", "webp", "gif", "bmp", "tif", "tiff", "pdf",
             "mp3", "flac", "ogg", "oga", "opus", "wav", "mp4", "m4v", "avi"}

NAMES = {"png": "PNG", "jpg": "JPEG", "webp": "WebP", "pdf": "PDF", "mp3": "MP3",
         "flac": "FLAC", "wav": "WAV", "ogg": "Ogg Vorbis", "opus": "Opus",
         "m4a": "AAC (m4a)", "mp4": "MP4", "mkv": "MKV", "webm": "WebM",
         "smaller-pdf": "a smaller PDF", "clean": "a copy without hidden details"}

# ffmpeg output options for each target. -vn drops any cover art or video.
AUDIO_OPTS = {
    "mp3": ["-vn", "-c:a", "libmp3lame", "-q:a", "2"],
    "flac": ["-vn", "-c:a", "flac"],
    "wav": ["-vn", "-c:a", "pcm_s16le"],
    "ogg": ["-vn", "-c:a", "libvorbis", "-q:a", "5"],
    "opus": ["-vn", "-c:a", "libopus", "-b:a", "128k"],
    "m4a": ["-vn", "-c:a", "aac", "-b:a", "192k"],
}
VIDEO_OPTS = {
    "mp4": ["-map", "0:v:0", "-map", "0:a:0?", "-sn", "-c:v", "libopenh264",
            "-b:v", "5M", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "160k",
            "-movflags", "+faststart"],
    # MKV holds almost any codec, so the streams are copied, not re-encoded.
    "mkv": ["-map", "0:v:0", "-map", "0:a?", "-sn", "-c", "copy"],
    "webm": ["-map", "0:v:0", "-map", "0:a:0?", "-sn", "-c:v", "libvpx-vp9",
             "-b:v", "0", "-crf", "32", "-row-mt", "1", "-c:a", "libopus",
             "-b:a", "128k"],
}


def kind_of(path):
    ext = Path(path).suffix.lower().lstrip(".")
    if ext in IMAGE:
        return "image"
    if ext == "pdf":
        return "pdf"
    if ext in AUDIO:
        return "audio"
    if ext in VIDEO:
        return "video"
    return None


def targets_for(path):
    kind = kind_of(path)
    ext = Path(path).suffix.lower().lstrip(".")
    ext = "jpg" if ext == "jpeg" else ext
    return [t for t in TARGETS.get(kind, []) if t != ext and (t != "clean" or ext in CLEAN_EXT)]


def save_dir(folder):
    """Where the copy goes: beside the original, or in Downloads when that folder is read-only."""
    global SAVED_ELSEWHERE
    if os.access(folder, os.W_OK):
        return folder
    fallback = Path.home() / "Downloads"
    try:
        fallback.mkdir(exist_ok=True)
    except OSError:
        pass
    if not os.access(fallback, os.W_OK):
        raise RuntimeError("its folder can't be written to, and neither can Downloads, so there is nowhere to save the copy")
    SAVED_ELSEWHERE = True
    return fallback


SAVED_ELSEWHERE = False


def free_name(directory, stem, ext):
    """A file name in directory that does not exist yet."""
    candidate = directory / f"{stem}.{ext}"
    n = 1
    while candidate.exists():
        candidate = directory / f"{stem} ({n}).{ext}"
        n += 1
    return candidate


def sandbox_prefix(scratch):
    """The bubblewrap command that runs a converter with no network."""
    if os.environ.get("ARKA_CONVERT_UNSANDBOXED") == "1":  # tests only
        return []
    bwrap = shutil.which("bwrap")
    if not bwrap:
        raise RuntimeError("the sandbox (bubblewrap) is not installed")
    return [bwrap, "--unshare-net", "--unshare-pid", "--unshare-ipc", "--die-with-parent",
            "--new-session", "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc",
            "--tmpfs", "/run/user", "--bind", str(scratch), str(scratch),
            "--chdir", str(scratch), "--setenv", "HOME", str(scratch),
            "--setenv", "TMPDIR", str(scratch)]


def run(scratch, cmd):
    done = subprocess.run(sandbox_prefix(scratch) + cmd, stdin=subprocess.DEVNULL,
                          stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if done.returncode != 0:
        lines = [l for l in done.stderr.strip().splitlines() if l.strip()]
        raise RuntimeError(lines[-1] if lines else f"{cmd[0]} failed")


def media_seconds(scratch, inp):
    """The length of a sound or video file in seconds, or None if unknown."""
    done = subprocess.run(sandbox_prefix(scratch) + [
        "ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", inp],
        stdin=subprocess.DEVNULL, capture_output=True, text=True)
    try:
        seconds = float(done.stdout.strip())
    except ValueError:
        return None
    return seconds if seconds > 0 else None


def progress_fraction(line, total):
    """Read one line of ffmpeg's -progress output; the fraction done, or None."""
    key, _, value = line.strip().partition("=")
    if key not in ("out_time_us", "out_time_ms") or not total:
        return None  # out_time_ms is also in microseconds, despite its name
    try:
        return max(0.0, min(1.0, int(value) / 1e6 / total))
    except ValueError:
        return None


def run_ffmpeg(scratch, cmd, total, on_progress):
    """Run ffmpeg in the sandbox, calling on_progress(fraction) as it goes."""
    errors = scratch / "ffmpeg-errors.txt"
    with open(errors, "w") as err, subprocess.Popen(
            sandbox_prefix(scratch) + cmd[:1] + ["-progress", "pipe:1", "-nostats"] + cmd[1:],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=err, text=True) as proc:
        try:
            for line in proc.stdout:
                fraction = progress_fraction(line, total)
                if fraction is not None and on_progress:
                    on_progress(fraction)
            proc.wait()
        finally:
            if proc.poll() is None:  # stopped part-way: end ffmpeg before its folder goes
                proc.terminate()
                proc.wait()
    if proc.returncode != 0:
        lines = [l for l in errors.read_text(errors="replace").splitlines() if l.strip()]
        raise RuntimeError(lines[-1] if lines else "ffmpeg failed")


def image_worker(src, dst, fmt):
    """Runs inside the sandbox: convert one picture with Pillow."""
    from PIL import Image
    with Image.open(src) as im:
        im.seek(0)  # animated pictures: first frame only
        if fmt in ("jpg", "pdf") and im.mode in ("RGBA", "LA", "P", "PA"):
            im = im.convert("RGBA")
            flat = Image.new("RGB", im.size, "white")
            flat.paste(im, mask=im.split()[-1])
            im = flat
        elif fmt in ("jpg", "pdf") and im.mode != "RGB":
            im = im.convert("RGB")
        names = {"jpg": "JPEG", "png": "PNG", "webp": "WEBP", "pdf": "PDF"}
        extra = {"quality": 92} if fmt in ("jpg", "webp") else {}
        im.save(dst, names[fmt], **extra)


def convert_one(src, fmt, on_progress=None):
    """Convert src to fmt. Returns the list of files made. For sound and video,
    on_progress(fraction) is called as ffmpeg works through the file."""
    src = Path(src).resolve()
    kind = kind_of(src)
    if kind is None:
        raise RuntimeError("this kind of file can't be converted yet")
    if fmt not in TARGETS[kind]:
        raise RuntimeError(f"{NAMES.get(fmt, fmt)} isn't available for this kind of file")
    if fmt == "clean" and src.suffix.lower().lstrip(".") not in CLEAN_EXT:
        raise RuntimeError("hidden details can't be removed from this kind of file yet")
    if fmt not in targets_for(src):
        raise RuntimeError(f"it is already {NAMES.get(fmt, fmt)}")
    out_dir = src.parent
    out_dir = save_dir(out_dir)
    scratch = Path(tempfile.mkdtemp(prefix=".arka-convert-", dir=out_dir))
    try:
        inp = str(src)
        if fmt == "clean":
            # mat2 writes its result next to its input, and the original's
            # folder is read-only in the sandbox, so it works on a copy here.
            ext = src.suffix.lower()
            work = scratch / f"in{ext}"
            shutil.copyfile(src, work)
            run(scratch, ["mat2", work.name])
            made = [scratch / f"in.cleaned{ext}"]
        elif kind == "image":
            tmp = scratch / f"out.{fmt}"
            run(scratch, [sys.executable, "-I", os.path.realpath(__file__),
                          "--image-worker", inp, str(tmp), fmt])
            made = [tmp]
        elif fmt == "smaller-pdf":
            # Ghostscript's "ebook" setting: pictures at 150 dpi, text untouched.
            tmp = scratch / "out.pdf"
            run(scratch, ["gs", "-sDEVICE=pdfwrite", "-dPDFSETTINGS=/ebook", "-dNOPAUSE",
                          "-dBATCH", "-dSAFER", "-dQUIET", "-sOutputFile=" + str(tmp), inp])
            if tmp.exists() and tmp.stat().st_size >= src.stat().st_size:
                raise RuntimeError("it is already as small as this makes it")
            made = [tmp]
        elif kind == "pdf":
            run(scratch, ["pdftoppm", "-png", "-r", "150", inp, str(scratch / "page")])
            made = sorted(scratch.glob("page-*.png"))
        else:
            tmp = scratch / f"out.{fmt}"
            opts = AUDIO_OPTS[fmt] if fmt in AUDIO_OPTS and (kind == "audio" or fmt == "mp3") \
                else VIDEO_OPTS[fmt]
            run_ffmpeg(scratch, ["ffmpeg", "-nostdin", "-loglevel", "error", "-i", inp, *opts, str(tmp)],
                       media_seconds(scratch, inp), on_progress)
            made = [tmp]
        made = [m for m in made if m.exists() and m.stat().st_size > 0]
        if not made:
            raise RuntimeError("the converter made no file")
        results = []
        for i, m in enumerate(made):
            if fmt == "clean":
                stem = f"{src.stem} (cleaned)"
            elif fmt == "smaller-pdf":
                stem = f"{src.stem} (smaller)"
            elif kind == "pdf":
                stem = src.stem if len(made) == 1 else f"{src.stem}-{i + 1}"
            else:
                stem = src.stem
            ext = {"smaller-pdf": "pdf", "clean": src.suffix.lstrip(".")}.get(fmt, fmt)
            final = free_name(out_dir, stem, ext)
            m.rename(final)
            results.append(final)
        return results
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def parse_time(text):
    """'90', '1:30' or '1:02:03.5' as seconds. Raises RuntimeError if it isn't a time."""
    try:
        parts = [float(p) for p in text.split(":")]
    except ValueError:
        parts = []
    if not 1 <= len(parts) <= 3 or any(p < 0 or p != p for p in parts) or "inf" in text.lower():
        raise RuntimeError(f"'{text}' isn't a time. Use seconds, mm:ss or hh:mm:ss")
    seconds = 0.0
    for p in parts:
        seconds = seconds * 60 + p
    return seconds


def edit_done(scratch, made, stems_exts):
    """Move finished files out of the scratch folder under names that are free."""
    made = [m for m in made if m.exists() and m.stat().st_size > 0]
    if not made:
        raise RuntimeError("the tool made no file")
    results = []
    for m, (out_dir, stem, ext) in zip(made, stems_exts):
        final = free_name(out_dir, stem, ext)
        m.rename(final)
        results.append(final)
    return results


def merge_pdfs(paths):
    """Join PDFs, in the order given, into one saved beside the first."""
    srcs = [Path(p).resolve() for p in paths]
    if len(srcs) < 2:
        raise RuntimeError("merging needs at least two PDFs")
    for s in srcs:
        if s.suffix.lower() != ".pdf":
            raise RuntimeError(f"{s.name} isn't a PDF")
    out_dir = srcs[0].parent
    out_dir = save_dir(out_dir)
    scratch = Path(tempfile.mkdtemp(prefix=".arka-convert-", dir=out_dir))
    try:
        tmp = scratch / "out.pdf"
        run(scratch, ["pdfunite", *map(str, srcs), str(tmp)])
        return edit_done(scratch, [tmp], [(out_dir, f"{srcs[0].stem} (merged)", "pdf")])
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def split_pdf(path):
    """Save every page of a PDF as its own PDF beside it."""
    src = Path(path).resolve()
    if src.suffix.lower() != ".pdf":
        raise RuntimeError(f"{src.name} isn't a PDF")
    out_dir = src.parent
    out_dir = save_dir(out_dir)
    scratch = Path(tempfile.mkdtemp(prefix=".arka-convert-", dir=out_dir))
    try:
        run(scratch, ["pdfseparate", str(src), str(scratch / "page-%d.pdf")])
        pages = sorted(scratch.glob("page-*.pdf"), key=lambda m: int(m.stem.split("-")[1]))
        if len(pages) < 2:
            raise RuntimeError("it has only one page")
        return edit_done(scratch, pages, [(out_dir, f"{src.stem} page {i + 1}", "pdf") for i in range(len(pages))])
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def trim_media(path, start, end, on_progress=None):
    """Keep START to END of a sound or video, re-encoded so the cut is exact."""
    src = Path(path).resolve()
    kind = kind_of(src)
    ext = src.suffix.lower().lstrip(".")
    t0, t1 = parse_time(start), parse_time(end)
    if kind not in ("audio", "video"):
        raise RuntimeError("only sound and video can be trimmed")
    if t1 <= t0:
        raise RuntimeError("the end has to be after the start")
    if kind == "audio" and ext in AUDIO_OPTS:
        opts = AUDIO_OPTS[ext]
    elif ext in ("mp4", "mkv"):
        opts = [o for o in VIDEO_OPTS["mp4"] if o not in ("-movflags", "+faststart")]
    elif ext == "webm":
        opts = VIDEO_OPTS["webm"]
    else:
        raise RuntimeError(f".{ext} can't be trimmed yet (mp3, wav, flac, ogg, opus, m4a, mp4, mkv, webm can)")
    out_dir = src.parent
    out_dir = save_dir(out_dir)
    scratch = Path(tempfile.mkdtemp(prefix=".arka-convert-", dir=out_dir))
    try:
        total = media_seconds(scratch, str(src))
        if total is not None and t0 >= total:
            raise RuntimeError("the start is after the end of the file")
        tmp = scratch / f"out.{ext}"
        # -ss after -i is slower but frame-exact; -t is the length to keep.
        run_ffmpeg(scratch, ["ffmpeg", "-nostdin", "-loglevel", "error", "-i", str(src),
                             "-ss", f"{t0:.3f}", "-t", f"{t1 - t0:.3f}", *opts, str(tmp)],
                   min(t1, total) - t0 if total else t1 - t0, on_progress)
        return edit_done(scratch, [tmp], [(out_dir, f"{src.stem} (trimmed)", ext)])
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def edit_image_worker(op, src, dst, args):
    """Runs inside the sandbox: one picture edit with Pillow."""
    from PIL import Image, ImageDraw, ImageOps
    with Image.open(src) as im:
        im.seek(0)
        im = ImageOps.exif_transpose(im)  # edit what is seen, not the raw pixels
        if op == "rotate":
            im = im.rotate({"left": 90, "right": -90, "flip": 180}[args[0]], expand=True)
        elif op == "crop":
            x, y, w, h = map(int, args)
            if w < 1 or h < 1 or x < 0 or y < 0 or x + w > im.width or y + h > im.height:
                raise RuntimeError(f"that box is outside the picture ({im.width} x {im.height})")
            im = im.crop((x, y, x + w, y + h))
        elif op == "redact":
            boxes = [tuple(map(int, args[i:i + 4])) for i in range(0, len(args), 4)]
            if im.mode in ("P", "LA", "PA"):
                im = im.convert("RGBA")
            elif im.mode not in ("RGB", "RGBA", "L"):
                im = im.convert("RGB")  # CMYK, 16-bit and the rest: "0" would not be black in all of them
            else:
                im = im.copy()
            draw = ImageDraw.Draw(im)
            black = (0, 0, 0, 255) if im.mode == "RGBA" else (0, 0, 0) if im.mode == "RGB" else 0
            for x, y, w, h in boxes:
                if w < 1 or h < 1:
                    raise RuntimeError("a box has no size")
                draw.rectangle((x, y, x + w - 1, y + h - 1), fill=black)  # the pixels are replaced, not covered
        elif op == "background":
            pad = int(args[1])
            colors = [tuple(int(c[i:i + 2], 16) for i in (1, 3, 5)) for c in args[0].split("-")]
            fg = im.convert("RGBA")
            size = (fg.width + 2 * pad, fg.height + 2 * pad)
            if len(colors) == 1:
                bg = Image.new("RGBA", size, colors[0] + (255,))
            else:  # top to bottom
                bg = Image.new("RGBA", size)
                top, bottom = colors[0], colors[1]
                draw = ImageDraw.Draw(bg)
                for yy in range(size[1]):
                    t = yy / max(1, size[1] - 1)
                    draw.line((0, yy, size[0], yy), fill=tuple(round(a + (b - a) * t) for a, b in zip(top, bottom)) + (255,))
            bg.alpha_composite(fg, (pad, pad))
            im = bg
        fmt = {"jpg": "JPEG", "jpeg": "JPEG", "png": "PNG", "webp": "WEBP"}.get(Path(dst).suffix.lower().lstrip("."), "PNG")
        if fmt == "JPEG" and im.mode != "RGB":
            im = im.convert("RGB")
        im.save(dst, fmt, **({"quality": 92} if fmt in ("JPEG", "WEBP") else {}))


def edit_image(op, path, args):
    """rotate, crop, redact or background on one picture; the copy is saved beside it."""
    src = Path(path).resolve()
    ext = src.suffix.lower().lstrip(".")
    if kind_of(src) != "image":
        raise RuntimeError("this only works on pictures")
    if op == "rotate" and args != [a for a in args if a in ("left", "right", "flip")][:1]:
        raise RuntimeError("rotate needs left, right or flip")
    if op in ("crop", "redact"):
        if not args or (op == "crop" and len(args) != 4) or len(args) % 4:
            raise RuntimeError("a box is four whole numbers: X Y W H")
        try:
            vals = [int(a) for a in args]
        except ValueError:
            raise RuntimeError("a box is four whole numbers: X Y W H") from None
        if any(v < 0 for v in vals) or any(vals[i] < 1 for i in range(2, len(vals), 4)) or any(vals[i] < 1 for i in range(3, len(vals), 4)):
            raise RuntimeError("a box needs a size and can't start before the picture")
    if op == "background":
        import re
        if len(args) != 2 or not re.fullmatch(r"#[0-9a-fA-F]{6}(-#[0-9a-fA-F]{6})?", args[0]) \
                or not args[1].isdigit() or int(args[1]) > 2000:
            raise RuntimeError("background needs a colour like #1E90FF (or two joined with -) and a padding of 0 to 2000")
    out_ext = ext if ext in ("png", "jpg", "jpeg", "webp") else "png"
    if op == "background" and ext in ("jpg", "jpeg", "webp"):
        out_ext = ext
    out_dir = src.parent
    out_dir = save_dir(out_dir)
    scratch = Path(tempfile.mkdtemp(prefix=".arka-convert-", dir=out_dir))
    try:
        tmp = scratch / f"out.{out_ext}"
        run(scratch, [sys.executable, "-I", os.path.realpath(__file__), "--edit-worker", op, str(src), str(tmp), *args])
        label = {"rotate": "rotated", "crop": "cropped", "redact": "redacted", "background": "with background"}[op]
        return edit_done(scratch, [tmp], [(out_dir, f"{src.stem} ({label})", out_ext)])
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def notify(text, body="", replace=None, urgency="normal"):
    """Show a desktop notification. Returns its id, or None."""
    if os.environ.get("ARKA_CONVERT_QUIET") == "1":
        return None
    exe = shutil.which("notify-send")
    if not exe:
        print(f"{text} {body}".strip(), file=sys.stderr)
        return None
    cmd = [exe, "-a", "ArkaOS", "-i", "document-export", "-u", urgency, "-p"]
    if replace:
        cmd += ["-r", str(replace)]
    done = subprocess.run(cmd + [text, body], capture_output=True, text=True)
    return done.stdout.strip() or None


def notify_done(text, path, replace=None):
    """The finished notification, with a "Show in Folder" button. notify-send
    has to stay alive to hear the click, so it runs in a detached copy of this
    program that ends when the notification goes away."""
    if os.environ.get("ARKA_CONVERT_QUIET") == "1" or not shutil.which("notify-send"):
        return notify(text, f"Saved as {Path(path).name}", replace)
    cmd = [sys.executable, "-I", os.path.realpath(__file__), "--notify-wait", str(path), text]
    if replace:
        cmd.append(str(replace))
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def notify_wait(path, text, replace=None):
    """--notify-wait: show the notification and open the folder if asked."""
    # -t: how long it stays up. The timeout is a backstop so this process can
    # never outlive a notification the desktop forgot to close.
    cmd = ["notify-send", "-a", "ArkaOS", "-i", "document-export", "-u", "normal", "-t", "10000", "-w",
           "-A", "show=Show in Folder"]
    if replace:
        cmd += ["-r", replace]
    try:
        done = subprocess.run(cmd + [text, f"Saved as {Path(path).name}"], capture_output=True, text=True,
                              timeout=60)
    except subprocess.TimeoutExpired:
        return
    if done.stdout.strip() == "show":
        show_in_folder(path)


def show_in_folder(path):
    """Ask the file manager (Dolphin) to open the folder with the file selected."""
    if shutil.which("dbus-send"):
        subprocess.run(["dbus-send", "--session", "--type=method_call",
                        "--dest=org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                        "org.freedesktop.FileManager1.ShowItems",
                        f"array:string:{Path(path).resolve().as_uri()}", "string:arka-convert"],
                       stdin=subprocess.DEVNULL, capture_output=True)


def refresh_folder(paths):
    """Tell open file managers that these files are new, so Dolphin lists them
    and makes their thumbnails now instead of waiting for its own watcher."""
    if not paths or os.environ.get("ARKA_CONVERT_QUIET") == "1" or not shutil.which("dbus-send"):
        return
    uris = [Path(p).resolve().as_uri() for p in paths]
    for member, arg in (("FilesAdded", f"string:{Path(paths[0]).resolve().parent.as_uri()}"),
                        ("FilesChanged", "array:string:" + ",".join(uris))):
        subprocess.run(["dbus-send", "--session", "--type=signal", "/", f"org.kde.KDirNotify.{member}", arg],
                       stdin=subprocess.DEVNULL, capture_output=True)


def run_edit(tool, args):
    """merge-pdf, split-pdf and trim: run one, tell the user, refresh Dolphin."""
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, _frame: sys.exit(128 + signum))
    wanted = {"merge-pdf": (2, None), "split-pdf": (1, 1), "trim": (3, 3), "rotate": (2, 2), "crop": (5, 5),
              "redact": (5, None), "background": (3, 3)}[tool]
    if len(args) < wanted[0] or (wanted[1] and len(args) > wanted[1]):
        print(__doc__.strip().split("\n\n")[0], file=sys.stderr)
        return 2
    title = {"merge-pdf": "Merged", "split-pdf": "Split", "trim": "Trimmed", "rotate": "Rotated", "crop": "Cropped",
             "redact": "Hidden parts blacked out", "background": "Background added"}[tool]
    try:
        if tool == "merge-pdf":
            made = merge_pdfs(args)
        elif tool == "split-pdf":
            made = split_pdf(args[0])
        elif tool == "trim":
            made = trim_media(args[0], args[1], args[2])
        else:
            made = edit_image(tool, args[0], args[1:])
    except (RuntimeError, OSError) as e:
        notify(f"Couldn't {tool.split('-')[0]}", f"{Path(args[0]).name}: {e}")
        return 1
    except (SystemExit, KeyboardInterrupt):
        notify(f"{title} stopped", "Files that were not finished were not saved.")
        raise
    refresh_folder(made)
    if len(made) == 1:
        notify_done(title, made[0])
    else:
        notify(title, f"{len(made)} files saved" + (" in Downloads" if SAVED_ELSEWHERE else " next to the original"))
    return 0


def main(argv):
    if len(argv) >= 6 and argv[1] == "--edit-worker":
        edit_image_worker(argv[2], argv[3], argv[4], argv[5:])
        return 0
    if len(argv) >= 5 and argv[1] == "--image-worker":
        image_worker(argv[2], argv[3], argv[4])
        return 0
    if len(argv) >= 4 and argv[1] == "--notify-wait":
        notify_wait(argv[2], argv[3], argv[4] if len(argv) > 4 else None)
        return 0
    if len(argv) == 3 and argv[1] == "--duration":
        with tempfile.TemporaryDirectory(prefix="arka-convert-") as d:
            seconds = media_seconds(Path(d), str(Path(argv[2]).resolve()))
        print(f"{seconds:.3f}" if seconds else "")
        return 0 if seconds else 1
    if len(argv) == 3 and argv[1] == "--targets":
        print("\n".join(targets_for(argv[2])))
        return 0
    if len(argv) >= 2 and argv[1] in ("merge-pdf", "split-pdf", "trim", "rotate", "crop", "redact", "background"):
        return run_edit(argv[1], argv[2:])
    if len(argv) < 3 or argv[1].startswith("-"):
        print(__doc__.strip().split("\n\n")[0], file=sys.stderr)
        return 2
    # Being stopped (logging out, a kill) unwinds like Ctrl+C, so the hidden
    # scratch folder is removed and no half-made file is left.
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, _frame: sys.exit(128 + signum))
    fmt, files = argv[1].lower(), argv[2:]
    fmt = "jpg" if fmt == "jpeg" else fmt
    heavy = any(kind_of(f) in ("audio", "video") for f in files)
    nid = notify(f"Converting to {NAMES.get(fmt, fmt)}",
                 files[0] if len(files) == 1 else f"{len(files)} files", urgency="low") if heavy else None
    made, failed = [], []
    last = [0.0]

    def progress_for(index, name):
        # Update the notification at most every two seconds.
        def update(fraction):
            now = time.monotonic()
            if nid and now - last[0] >= 2:
                last[0] = now
                where = f" ({index + 1} of {len(files)})" if len(files) > 1 else ""
                notify(f"Converting to {NAMES.get(fmt, fmt)}", f"{name}{where}: {int(fraction * 100)}%", nid, "low")
        return update

    try:
        for i, f in enumerate(files):
            try:
                made += convert_one(f, fmt, progress_for(i, Path(f).name))
            except Exception as e:  # one bad file does not stop the rest
                failed.append(f"{Path(f).name}: {e}")
    except (SystemExit, KeyboardInterrupt):
        notify("Conversion stopped", "Files that were not finished were not saved.", nid)
        raise
    refresh_folder(made)
    if failed:
        notify("Couldn't convert everything", "\n".join(failed[:4]), nid)
    elif len(made) == 1:
        notify_done("Removed hidden details" if fmt == "clean" else "Converted", made[0], nid)
    else:
        notify("Converted", f"{len(made)} files saved" + (" in Downloads" if SAVED_ELSEWHERE else " next to the originals"), nid)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
