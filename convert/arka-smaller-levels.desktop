[Desktop Entry]
Type=Service
MimeType=image/jpeg;image/png;image/webp;application/pdf;audio/mpeg;audio/x-wav;audio/flac;audio/x-flac;audio/ogg;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/aac;video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/ogg;
Actions=level_light;level_medium;level_strong;
X-KDE-Submenu=Make smaller, your way
X-KDE-Priority=TopLevel

[Desktop Action level_light]
Name=Light (keeps the most quality)
Exec=arka-convert smaller:light %F
Icon=application-x-compressed

[Desktop Action level_medium]
Name=Medium (a smaller file)
Exec=arka-convert smaller:medium %F
Icon=application-x-compressed

[Desktop Action level_strong]
Name=Strong (the smallest file, lower quality)
Exec=arka-convert smaller:strong %F
Icon=application-x-compressed
