[Desktop Entry]
Type=Service
MimeType=audio/mpeg;audio/x-wav;audio/wav;audio/flac;audio/x-flac;audio/ogg;audio/opus;audio/mp4;audio/x-m4a;audio/aac;
Actions=trim;split;bleep;
X-KDE-Submenu=Edit sound
X-KDE-Priority=TopLevel
X-KDE-MaxNumberOfUrls=1

[Desktop Action trim]
Name=Trim...
Exec=arka-edit trim %f
Icon=edit-cut

[Desktop Action split]
Name=Split in two...
Exec=arka-edit split %f
Icon=view-split-left-right

[Desktop Action bleep]
Name=Bleep out parts...
Exec=arka-edit bleep %f
Icon=audio-volume-muted
