[Desktop Entry]
Type=Service
MimeType=application/vnd.apple.pages;application/x-iwork-pages-sffpages;
Actions=docx;pdf;
X-KDE-Submenu=Convert to
X-KDE-Priority=TopLevel

[Desktop Action docx]
Name=Word
Exec=arka-convert docx %F
Icon=x-office-document

[Desktop Action pdf]
Name=PDF
Exec=arka-convert pdf %F
Icon=application-pdf
