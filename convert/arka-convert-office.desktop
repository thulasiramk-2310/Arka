[Desktop Entry]
Type=Service
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/msword;application/vnd.oasis.opendocument.text;application/rtf;text/rtf;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel;application/vnd.oasis.opendocument.spreadsheet;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.ms-powerpoint;application/vnd.oasis.opendocument.presentation;
Actions=pdf;
X-KDE-Submenu=Convert to
X-KDE-Priority=TopLevel

[Desktop Action pdf]
Name=PDF
Exec=arka-convert pdf %F
Icon=application-pdf
