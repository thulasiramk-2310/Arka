[Desktop Entry]
Type=Service
MimeType=application/pdf;
Actions=png;smaller-pdf;
X-KDE-Submenu=Convert to
X-KDE-Priority=TopLevel

[Desktop Action png]
Name=PNG
Exec=arka-convert png %F
Icon=application-pdf

[Desktop Action smaller-pdf]
Name=Smaller PDF
Exec=arka-convert smaller-pdf %F
Icon=application-pdf
