#!/bin/bash
# arka-health-report — report-only boot health checks for ArkaOS.
#
# Runs the same check scripts greenboot uses (required.d / wanted.d under
# /usr/lib/greenboot/check and /etc/greenboot/check) and records the result.
# It NEVER restarts the computer, sets a boot counter or selects a boot entry:
# greenboot 0.16.4's automatic path did all three and, in a VM test on
# 2026-10-11, kept a broken update booted (see docs/RELEASE-VALIDATION.md).
# Going back stays a deliberate `bootc rollback`.
#
# Results: the journal (tag arka-health), /run/arkaos/health.json, and a line
# in /etc/motd.d/arka-health for terminal logins.
set -u

STATE_DIR=/run/arkaos
OUT=$STATE_DIR/health.json
MOTD=/etc/motd.d/arka-health
TIMEOUT=${ARKA_HEALTH_TIMEOUT:-120}
log() { echo "$*" | systemd-cat -t arka-health -p "${2:-info}" 2>/dev/null || echo "$*"; }

# Leave a trap from older images: if greenboot left a boot counter armed,
# GRUB's greenboot rule would keep choosing the second boot entry. Clear it.
clear_old_counter() {
    command -v grub2-editenv >/dev/null || return 0
    grub2-editenv list 2>/dev/null | grep -q '^boot_counter=' || return 0
    local was_ro=0
    findmnt -no OPTIONS /boot 2>/dev/null | grep -qw ro && was_ro=1
    [ $was_ro = 1 ] && mount -o remount,rw /boot
    grub2-editenv - unset boot_counter && grub2-editenv - set boot_success=1 &&
        log "Cleared a leftover greenboot boot counter so the chosen boot entry is respected" warning
    [ $was_ro = 1 ] && mount -o remount,ro /boot
    return 0
}

run_dir() {   # run_dir <required|wanted>; prints failures, returns count
    local kind=$1 failed=0 script name
    for dir in /usr/lib/greenboot/check/$kind.d /etc/greenboot/check/$kind.d; do
        [ -d "$dir" ] || continue
        for script in "$dir"/*; do
            [ -f "$script" ] && [ -x "$script" ] || continue
            name=$(basename "$script")
            if timeout "$TIMEOUT" "$script" >/dev/null 2>&1; then
                log "$kind check passed: $name"
            else
                log "$kind check FAILED: $name" err
                echo "$name"; failed=$((failed + 1))
            fi
        done
    done
    return $failed
}

clear_old_counter
mkdir -p "$STATE_DIR" /etc/motd.d
req_failed=$(run_dir required); req_n=$?
want_failed=$(run_dir wanted); want_n=$?

json_list() { printf '%s\n' "$1" | sed '/^$/d; s/"/\\"/g; s/.*/"&"/' | paste -sd, -; }
if [ "$req_n" -eq 0 ]; then status=healthy; else status=unhealthy; fi
printf '{"status":"%s","checked":%s,"required_failed":[%s],"wanted_failed":[%s]}\n' \
    "$status" "$(date +%s)" "$(json_list "$req_failed")" "$(json_list "$want_failed")" > "$OUT.tmp" &&
    mv -f "$OUT.tmp" "$OUT"

if [ "$status" = healthy ]; then
    log "Boot health: all required checks passed"
    rm -f "$MOTD"
else
    log "Boot health: $req_n required check(s) failed. Nothing was changed automatically; to go back to the previous version run: sudo bootc rollback" err
    printf 'ArkaOS boot health: %s required check(s) failed (%s).\nNothing was changed automatically. To go back to the previous version: sudo bootc rollback\n' \
        "$req_n" "$(printf '%s' "$req_failed" | paste -sd' ' -)" > "$MOTD"
fi
exit 0
