#!/bin/bash
# ArkaOS sandboxed browser — wraps /usr/bin/firefox-unwrapped via bubblewrap.
# This file IS /usr/bin/firefox in the deployed image.
#
# Usage:
#   firefox [args]      — launch Firefox in the sandbox
#   firefox --shell     — open bash in the IDENTICAL sandbox (isolation testing)
#   firefox --shell -c 'cmd'  — run cmd in the identical sandbox non-interactively
#
# Isolation model:
#   - /home entirely hidden (tmpfs); only ~/Downloads re-exposed via bind
#   - /etc allowlisted: resolv.conf, ssl, pki, fonts, localtime, nsswitch — no
#     NM profiles, no arkad config, no machine-id
#   - /run: tmpfs (no D-Bus session access; headless Firefox doesn't need it)
#   - New PID, IPC, UTS namespaces; die-with-parent

set -euo pipefail

BROWSER=/usr/bin/firefox-unwrapped
HOME="${HOME:?A home directory is required}"
[[ "$HOME" = /* && "$HOME" != / ]] || { echo 'Invalid home directory' >&2; exit 1; }
DOWNLOADS="$HOME/Downloads"
# A symlink such as Downloads -> .. would expose the entire real home.
[[ ! -L "$DOWNLOADS" ]] || { echo 'Downloads must be a real directory, not a symlink' >&2; exit 1; }
mkdir -p -- "$DOWNLOADS"
[[ "$(realpath -e -- "$DOWNLOADS")" = "$(realpath -e -- "$HOME")/Downloads" ]] || {
    echo 'Downloads resolves outside its expected directory' >&2; exit 1;
}
WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
[[ "$WAYLAND_DISPLAY" =~ ^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$ ]] || {
    echo 'Unsupported Wayland socket name' >&2; exit 1;
}

# Single source of truth for sandbox args.
# Both browser launch and --shell mode use this array identically.
BWRAP_ARGS=(
    # Do not hand API keys, agent sockets, loader overrides or other launcher
    # environment data to a compromised browser. Preserve only UI essentials.
    --clearenv
    --setenv PATH /usr/bin:/bin
    --setenv HOME "$HOME"
    --setenv LANG "${LANG:-C.UTF-8}"
    --setenv LC_ALL "${LC_ALL:-${LANG:-C.UTF-8}}"
    # System directories — read-only
    --ro-bind /usr /usr
    --ro-bind /lib /lib
    --ro-bind /lib64 /lib64
    --ro-bind /bin /bin
    --ro-bind /sbin /sbin
    # /etc: allowlist only; no NM creds, no arkad config, no machine-id
    --tmpfs /etc
    --ro-bind-try /etc/resolv.conf    /etc/resolv.conf
    --ro-bind-try /etc/hosts          /etc/hosts
    --ro-bind-try /etc/nsswitch.conf  /etc/nsswitch.conf
    --ro-bind-try /etc/ssl            /etc/ssl
    --ro-bind-try /etc/pki            /etc/pki
    --ro-bind-try /etc/fonts          /etc/fonts
    --ro-bind-try /etc/localtime      /etc/localtime
    --ro-bind-try /etc/ld.so.cache    /etc/ld.so.cache
    --ro-bind-try /etc/ld.so.conf.d   /etc/ld.so.conf.d
    --ro-bind-try /etc/alternatives   /etc/alternatives
    # Devices, proc
    --dev /dev
    --proc /proc
    # Writable scratch areas
    --tmpfs /tmp
    # /run: fresh tmpfs, then thread the Wayland socket back through so Firefox
    # can connect to the compositor. D-Bus session bus stays hidden.
    --tmpfs /run
    --dir /run/user
    --dir /run/user/"${UID}"
    --bind-try /run/user/"${UID}"/"${WAYLAND_DISPLAY:-wayland-0}" \
               /run/user/"${UID}"/"${WAYLAND_DISPLAY:-wayland-0}"
    # Audio: thread the PipeWire and PulseAudio-compat sockets
    # through so the browser can actually play sound. libpulse/libpipewire find
    # these automatically under XDG_RUNTIME_DIR. This is a deliberate capability
    # grant. Direct audio-server access can include microphone recording;
    # this is not a playback-only permission or a portal-mediated grant.
    --bind-try /run/user/"${UID}"/pipewire-0 \
               /run/user/"${UID}"/pipewire-0
    --bind-try /run/user/"${UID}"/pulse/native \
               /run/user/"${UID}"/pulse/native
    # Select the mounted socket explicitly; do not inherit a launcher server
    # or rely on client configuration hidden by the isolated home and /etc.
    --setenv PULSE_SERVER unix:/run/user/"${UID}"/pulse/native
    --setenv XDG_RUNTIME_DIR /run/user/"${UID}"
    --setenv WAYLAND_DISPLAY "${WAYLAND_DISPLAY:-wayland-0}"
    --setenv MOZ_ENABLE_WAYLAND 1
    # Home isolation: tmpfs hides all of /home, then re-expose Downloads only
    --tmpfs /home
    --tmpfs /root
    --dir "$HOME"
    --bind  "${DOWNLOADS}" "${DOWNLOADS}"
    --chdir "$HOME"
    # Namespace isolation
    --unshare-pid
    --unshare-ipc
    --unshare-uts
    --hostname arka-browser
    --cap-drop ALL
    --new-session
    --die-with-parent
)

if [[ "${1:-}" == "--shell" ]]; then
    shift
    exec bwrap "${BWRAP_ARGS[@]}" /bin/bash "${@:--i}"
fi

exec bwrap "${BWRAP_ARGS[@]}" "${BROWSER}" "$@"
