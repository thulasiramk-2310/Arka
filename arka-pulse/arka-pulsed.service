[Unit]
Description=ArkaOS Reliability Daemon (read-only, org.arka.pulse)
Documentation=file:///usr/share/doc/arkaos/RELIABILITY-ARKA-PULSE.md

[Service]
# Plain simple service: arka-pulse has no sd_notify dependency (the core stays
# near-zero-dep), so no Type=notify / WatchdogSec here as arkad uses. It only
# reads /proc + /sys and publishes a snapshot; it changes nothing.
Type=simple
ExecStart=/usr/bin/arka-pulsed --interval 10
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# The daemon only reads /proc and /sys and answers on the system bus, so it is
# given nothing else: no writable files, no devices, no network, no privileges.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
