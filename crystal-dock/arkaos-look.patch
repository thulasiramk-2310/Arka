+// A small rounded label above the icon, light or dark to match the dock.
+void DockPanel::drawTooltipBubble(QPainter& painter) {
+  const auto& item = items_[activeItem_];
+  const QString label = item->getLabel();
+  if (label.isEmpty()) { return; }
+  QFont font;
+  font.setPointSize(model_->tooltipFontSize());
+  QFontMetrics metrics(font);
+  const int padX = metrics.height() * 3 / 4;
+  const int padY = metrics.height() / 5;
+  const int w = metrics.horizontalAdvance(label) + 2 * padX;
+  const int h = metrics.height() + 2 * padY;
+  int x = item->left_ + item->getWidth() / 2 - w / 2;
+  x = std::max(0, std::min(x, maxWidth_ - w));
+  const int gap = h / 3;
+  int y = isTop() ? item->top_ + item->getHeight() + gap : item->top_ - gap - h;
+  y = std::max(0, std::min(y, maxHeight_ - h));
+
+  const bool light = model_->backgroundColor2D().lightness() > 128;
+  const QColor fill = light ? QColor(250, 250, 251, 235) : QColor(36, 39, 44, 235);
+  const QColor edge = light ? QColor(0, 0, 0, 36) : QColor(255, 255, 255, 36);
+  const QColor text = light ? QColor(28, 32, 39) : QColor(240, 242, 245);
+  painter.save();
+  painter.setRenderHint(QPainter::Antialiasing);
+  QPainterPath path;
+  path.addRoundedRect(QRectF(x + 0.5, y + 0.5, w - 1, h - 1), h * 0.3, h * 0.3);
+  painter.fillPath(path, fill);
+  painter.setPen(edge);
+  painter.drawPath(path);
+  painter.setFont(font);
+  painter.setPen(text);
+  painter.drawText(QRect(x, y, w, h), Qt::AlignCenter, label);
+  painter.restore();
+}
+
+// KWin blurs what is behind the dock, inside its rounded background only.
+void DockPanel::updateBlur(const QRect& rect, int radius) {
+  if (!isFlat2D()) { return; }
+  QPainterPath path;
+  path.addRoundedRect(QRectF(rect), radius, radius);
+  setBlurRegion(QRegion(path.toFillPolygon().toPolygon()));
+}
+
+void DockPanel::setBlurRegion(const QRegion& region) {
+  if (region == blurRegion_ || windowHandle() == nullptr) { return; }
+  blurRegion_ = region;
+  KWindowEffects::enableBlurBehind(windowHandle(), !region.isEmpty(), region);
+}
