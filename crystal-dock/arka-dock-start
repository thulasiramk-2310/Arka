#!/bin/sh
# Start the ArkaOS Dock. An account made before the dock changed has no dock
# settings, and Crystal Dock would then open its first-run window, so copy the
# ArkaOS settings in first. Settings an account already has are never replaced.
for d in KDE generic; do
    D=$HOME/.config/crystal-dock/$d
    if [ ! -f "$D/panel_1.conf" ]; then
        mkdir -p "$D" && cp /etc/skel/.config/crystal-dock/$d/*.conf "$D/"
        seeded=1
    fi
done
# The copied settings are the dark ones; match an account that chose Light.
if [ -n "${seeded:-}" ] && [ "$(cat "$HOME/.config/arka-look" 2>/dev/null)" = light ]; then
    for d in KDE generic; do
        f=$HOME/.config/crystal-dock/$d/appearance.conf
        kwriteconfig6 --file "$f" --group General --key backgroundColor2D '#99f6f7f9'
        kwriteconfig6 --file "$f" --group General --key borderColor '#33000000'
        kwriteconfig6 --file "$f" --group General --key activeIndicatorColor2D '#3c4148'
        kwriteconfig6 --file "$f" --group General --key inactiveIndicatorColor2D '#3c4148'
    done
fi
exec /usr/bin/crystal-dock
