#!/bin/bash
# ArkaOS: apply the branded wallpaper + accent on first Plasma login, then
# disable this autostart entry. The dark color scheme is already preset via
# /etc/skel/.config/kdeglobals, so this only handles what needs the running
# Plasma session (the official plasma-apply-* tools talk to plasmashell).

# Give plasmashell a moment to be ready for the apply tools.
sleep 3

# Apply the look chosen in setup (written by arkaos-oobe-apply; dark when
# absent): colours, Plasma style, icons and wallpapers. The same script backs
# ArkaOS Settings > Appearance, so both always agree.
LOOK=$(cat "$HOME/.config/arka-look" 2>/dev/null)
[ "$LOOK" = light ] || LOOK=dark
/usr/libexec/arka-apply-look "$LOOK"

# Reshape the desktop toward the ArkaOS layout (top bar + floating dock +
# launcher) via Plasma's scripting API.
LAYOUT=/usr/share/arka/arka-layout.js
# arka-apply-look restarts plasmashell; wait (up to 20 s) until it is back on
# the session bus before sending it the layout script.
for _ in $(seq 1 40); do
    dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus.NameHasOwner string:org.kde.plasmashell 2>/dev/null | grep -q "boolean true" && break
    sleep 0.5
done
sleep 1
# New desktops get the ArkaOS layout from the ArkaOS global theme; only
# reshape a desktop that doesn't have it yet (e.g. created before that existed).
if [ -f "$LAYOUT" ] && ! grep -q -e "org.arkaos.launcher" -e "org.kde.plasma.kickerdash" "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" 2>/dev/null; then
    dbus-send --session --type=method_call --dest=org.kde.plasmashell \
        /PlasmaShell org.kde.PlasmaShell.evaluateScript \
        string:"$(cat "$LAYOUT")" 2>/dev/null || true
fi

# One-shot: remove the autostart entry so this never runs again.
rm -f "$HOME/.config/autostart/arka-plasma-firstrun.desktop"
